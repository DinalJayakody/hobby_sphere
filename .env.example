VITE_BACKEND_URL=http://localhost:8080

# Sign in with Apple (optional). Leave blank to hide the Apple button.
# 1. Apple Developer > Certificates, IDs & Profiles > Identifiers > Services IDs
#    Create/select a Services ID (this is your "client id", looks like
#    "com.hobbysphere.web.signin" — NOT the app's bundle id).
# 2. On that Services ID, enable "Sign in with Apple", configure it, and add
#    this exact web domain + a return URL matching VITE_APPLE_REDIRECT_URI
#    below (must be an HTTPS URL Apple can reach — localhost won't work for
#    a real test, only for wiring the code up).
# VITE_APPLE_CLIENT_ID=com.hobbysphere.web.signin
# VITE_APPLE_REDIRECT_URI=https://hobbysphereai.com
